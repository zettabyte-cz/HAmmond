# xomtra in the local access mode (ADR 056): the MCP endpoint and the admin GUI are
# reachable only in the LAN, nothing is exposed to the internet and no public DNS name,
# ACME or port forward is needed. TLS uses Caddy's own local CA; clients trust it by
# importing https://<host>/xomtra-ca.crt (or pin it in the Claude Desktop extension).
#
# Required environment:
#   XOMTRA_LOCAL_HOST  name or IP address clients use, e.g. xomtra.home.arpa or 192.168.1.20
#   LAN_CIDR            space separated CIDRs allowed to use the MCP endpoint
#   ADMIN_CIDR          space separated CIDRs allowed to open the admin GUI
#
# Access model:
#   - /mcp: from LAN_CIDR, with a personal token (checked by the MCP server).
#   - /admin (admin GUI and Dagster UI): from ADMIN_CIDR; the admin app requires a
#     sign-in with the admin role (Home Assistant or Entra, ADR 041/053).
#   - /xomtra-ca.crt: the root certificate of the local CA (public by nature), from
#     LAN_CIDR, so that clients can trust the server.
#   - http://caddy:8081/xomtra-ca.crt: the same certificate for the admin app inside the
#     compose network (the port is not published); the admin app puts it into the
#     Claude Desktop extension it builds, which then trusts only this CA.
{
	admin off
	http_port 8080
	https_port 8443
	auto_https disable_redirects
	local_certs
	skip_install_trust
	# Clients that connect by IP address send no SNI.
	default_sni {$XOMTRA_LOCAL_HOST}
	pki {
		ca local {
			name "xomtra local CA"
		}
	}
}

(refuse) {
	header Content-Type "text/plain; charset=utf-8"
	header Cache-Control "no-store"
	respond "{args[1]}" {args[0]}
}

https://{$XOMTRA_LOCAL_HOST} {
	tls internal

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		output stdout
		format json
	}

	@admin path /admin /admin/*
	handle @admin {
		@admin_net remote_ip {$ADMIN_CIDR}
		handle @admin_net {
			@dagster path /admin/dagster /admin/dagster/*
			handle @dagster {
				forward_auth admin:8100 {
					uri /admin/auth/check
					copy_headers X-xomtra-User
				}
				reverse_proxy dagster-webserver:3000
			}
			handle {
				reverse_proxy admin:8100
			}
		}
		handle {
			import refuse 403 Forbidden
		}
	}

	@lan remote_ip {$LAN_CIDR}

	@ca path /xomtra-ca.crt
	handle @ca {
		handle @lan {
			header Content-Type "application/x-x509-ca-cert"
			header Content-Disposition "attachment; filename=xomtra-ca.crt"
			rewrite * /root.crt
			root * /data/caddy/pki/authorities/local
			file_server
		}
		handle {
			import refuse 403 Forbidden
		}
	}

	@mcp path /mcp /mcp/* /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/*
	handle @mcp {
		handle @lan {
			reverse_proxy mcp:8000 {
				# MCP streamable HTTP uses SSE responses: do not buffer.
				flush_interval -1
			}
		}
		handle {
			import refuse 403 Forbidden
		}
	}

	# The bare address opens the admin GUI (it guards itself and ADMIN_CIDR above).
	handle / {
		redir /admin/ 302
	}

	handle {
		import refuse 404 "Not found"
	}
}

http://:8081 {
	@ca path /xomtra-ca.crt
	handle @ca {
		header Content-Type "application/x-pem-file"
		rewrite * /root.crt
		root * /data/caddy/pki/authorities/local
		file_server
	}
	handle {
		respond 404
	}
}
